PORT=5003

# MongoDB Atlas connection string. Use the actual database username, password,
# and cluster host from Atlas. Keep authSource=admin for Atlas database users.
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster-host>/alzehrasilk?retryWrites=true&w=majority&authSource=admin

# Admin account created during initial database seeding.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-unique-password

# Optional integrations
# PUBLIC_API_URL=https://api.example.com
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_UPLOAD_PRESET=
# FSHIP_API_TOKEN=
# FSHIP_TRACK_API_URL=https://capi.fship.in/api/track
